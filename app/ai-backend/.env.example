# ===== 讯飞 RTASR(实时语音转写 大模型版)—— /stream 实时字幕 + rtasr 兜底用 =====
# 控制台 → 实时语音转写;鉴权用 accessKeyId/Secret 做 HMAC-SHA1
XFYUN_APP_ID=
XFYUN_ACCESS_KEY_ID=
XFYUN_ACCESS_KEY_SECRET=

# ===== 讯飞 LFASR(录音文件转写 大模型版,HTTP)—— 异步 /process 默认转写 =====
# 凭据复用上面的 XFYUN_*(appId/APIKey=ACCESS_KEY_ID/APISecret=ACCESS_KEY_SECRET 与 RTASR 同一套),无需额外 key。
# 角色分离:roleType 0=关 1=通用角色分离(默认) 3=声纹;roleNum 0=盲分自动,2..=指定人数
LFASR_ROLE_TYPE=1
LFASR_ROLE_NUM=0
# 异步转写选哪种:lfasr=批量(默认,分钟级)/ rtasr=实时(基线/兜底,≈音频时长)
TRANSCRIBER=lfasr

# ===== LLM(OpenAI 兼容)—— 豆包/方舟、OpenClaw、OpenAI 等均可 =====
# LLM_* 优先;未设时回退 ARK_*
LLM_API_KEY=
LLM_MODEL=doubao-seed-2-0-lite-260428
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选:ark-doubao | openai-compatible;不设则按 baseURL 自动推断
# LLM_PROVIDER=openai-compatible

# ===== 火山方舟(豆包)—— 向后兼容旧名 =====
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-lite-260428
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenClaw 示例:
# LLM_API_KEY=your-openclaw-key
# LLM_BASE_URL=https://openclaw-api.com/v1
# LLM_MODEL=claude-sonnet-4-6
# LLM_PROVIDER=openai-compatible

# ===== 后端 =====
PORT=8787
# 每帧(1280B PCM=40ms 音频)发送间隔 ms;40=实时(最稳),调小=加速(长录音更快,过小可能被讯飞限流)
RTASR_FRAME_MS=40
