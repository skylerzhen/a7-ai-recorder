# ===== 讯飞 RTASR(实时语音转写 大模型版)—— /stream 实时字幕 + rtasr 兜底用 =====
# 控制台 → 实时语音转写;鉴权用 accessKeyId/Secret 做 HMAC-SHA1
XFYUN_APP_ID=
XFYUN_ACCESS_KEY_ID=
XFYUN_ACCESS_KEY_SECRET=
# ASR 语言:autodialect=中文+方言(默认) / en=英语(英文会议可试)
# ASR_LANG 同时作用于实时(RTASR)与会后(LFASR);也可单独设 RTASR_LANG / LFASR_LANGUAGE
# ASR_LANG=en

# ===== 讯飞 LFASR(录音文件转写 大模型版,HTTP)—— 异步 /process 默认转写 =====
# 凭据复用上面的 XFYUN_*(appId/APIKey=ACCESS_KEY_ID/APISecret=ACCESS_KEY_SECRET 与 RTASR 同一套),无需额外 key。
# 角色分离:roleType 0=关 1=通用角色分离(默认) 3=声纹;roleNum 0=盲分自动,2..=指定人数
LFASR_ROLE_TYPE=1
LFASR_ROLE_NUM=0
# 异步转写选哪种:lfasr=批量(默认,分钟级)/ rtasr=实时(基线/兜底,≈音频时长)
TRANSCRIBER=lfasr

# ===== LLM(OpenAI 兼容)—— 豆包/方舟、OpenClaw Gateway、OpenAI 等均可 =====
# LLM_* 优先;未设时回退 ARK_*;OpenClaw 可用 OPENCLAW_* 快捷变量(见下方)

# --- 方案 A: OpenClaw Gateway(Leader 推荐) ---
# OpenClaw 不是云账号,是公司/本机跑的 Gateway,暴露 OpenAI 兼容 /v1/chat/completions
# 文档: https://docs.openclaw.ai/gateway/openai-http-api
# 1) 安装并启动: npm i -g openclaw && openclaw onboard && openclaw gateway
# 2) 开启 HTTP 端点(默认关闭):
#    openclaw config set gateway.http.endpoints.chatCompletions.enabled true
#    openclaw gateway restart
# 3) Token 在 ~/.openclaw/openclaw.json 的 gateway.auth 里
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1
OPENCLAW_GATEWAY_TOKEN=
LLM_MODEL=openclaw:main
LLM_PROVIDER=openai-compatible

# Docker 部署 ai-backend 且 OpenClaw 跑在宿主机时,URL 改为:
# OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789/v1

# --- 方案 B: 火山方舟 / 豆包(不用 OpenClaw 时取消注释) ---
# LLM_API_KEY=
# LLM_MODEL=doubao-seed-2-0-lite-260428
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 火山方舟(豆包)—— 向后兼容旧名 =====
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-lite-260428
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 后端 =====
PORT=8787
# 每帧(1280B PCM=40ms 音频)发送间隔 ms;40=实时(最稳),调小=加速(长录音更快,过小可能被讯飞限流)
RTASR_FRAME_MS=40
